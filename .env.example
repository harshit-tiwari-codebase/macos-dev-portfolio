# ═══════════════════════════════════════════════════════════════
#  Harshit's macOS Portfolio — Environment Variables
#  Copy this file to .env and fill in your values.
#  ALL variables are OPTIONAL — the app runs with graceful fallbacks.
# ═══════════════════════════════════════════════════════════════

# ── Google Gemini AI ──────────────────────────────────────────
# Powers the "Ask Harshit AI" chat window.
# Get a FREE key at: https://aistudio.google.com
# If not set → AI chat falls back to curated offline answers.
VITE_GEMINI_API_KEY=

# ── EmailJS (Contact Form) ───────────────────────────────────
# Powers the contact form email delivery.
# Get a FREE account at: https://emailjs.com
# If not set → Contact button falls back to mailto: link.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── Dev.to Blog Integration ──────────────────────────────────
# Your Dev.to username to fetch blog posts in the Blog window.
# If not set → Blog window shows a placeholder.
VITE_DEVTO_USERNAME=harshit
